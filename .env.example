# Neon Postgres (pooled connection string)
DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require

# Auth.js — generate with: openssl rand -base64 32
AUTH_SECRET=
# Production site URL (optional in Auth.js v5; set for previews if needed)
AUTH_URL=http://localhost:3000

# Vercel Blob — create a Blob store in the Vercel project and paste the token
BLOB_READ_WRITE_TOKEN=

# Optional tip / Buy Me a Coffee style link
NEXT_PUBLIC_TIP_URL=https://buymeacoffee.com

# Vercel AI Gateway — short reflections after marking a setup task done
# Create a key: Vercel Dashboard → AI Gateway → API Keys
#   or: vercel ai-gateway api-keys create --name cuerom
# On Vercel deployments, OIDC (VERCEL_OIDC_TOKEN) can auth without a key.
# Without either, the app falls back to the static bilingual encouragement pool.
AI_GATEWAY_API_KEY=

# Preview / demo backdoor — bookmarkable URL: /preview?key=<token>
# Generate with: openssl rand -hex 24
# Does not weaken /today auth. Shows sample fixtures only (never real DB rows).
PREVIEW_BYPASS_TOKEN=

# Auth path shipped: Auth.js (NextAuth v5) + Credentials + Neon
# Clerk was not available at build time (no CLERK_* keys). To switch later:
# CLERK_SECRET_KEY=
# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
